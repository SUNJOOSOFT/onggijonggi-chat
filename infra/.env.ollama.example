# docker-compose 용 환경변수 템플릿 — 내 PC에서 돌리는 Ollama에 붙는 구성. .env 로 복사해서 쓴다.
#
#     cp .env.ollama.example .env
#     Windows: Copy-Item .env.ollama.example .env
#
# 고칠 곳은 받은 모델 이름 한 줄뿐이다. 키는 필요 없다. 나머지는 그대로 두면 그대로 돈다.
#
# 🔒 여기 적힌 비밀번호·토큰은 저장소에 공개된 값이라 아무나 알 수 있다. 혼자 시험할 때만 쓰고,
#    여러 사람이 접속하게 하려면 최초 기동 **전에** 바꾼다.
#    특히 KEYCLOAK_BFF_CLIENT_SECRET은 모든 계정 목록·관리자 변경 이력을 읽는 권한이 붙은 값이라,
#    Keycloak 포트(8081)에 닿는 누구나 쓸 수 있다.


# ───────────── 여기만 채운다 ─────────────

# 받은 모델 이름. config/litellm_config_ollama.yaml의 model_name과 같아야 한다.
#   확인: ollama list
# Ollama 설치·기동 절차는 INSTALL_models.md의 "내 PC의 Ollama".
LLM_MODEL=gemma3:4b

# ───────────── 아래는 그대로 둔다 ─────────────
#
# 다른 모델 구성이 필요하면 이 파일 대신 옆 템플릿을 복사한다(INSTALL_models.md).
#   .env.example          Gemini 하나 — 가장 간단하다
#   .env.multi.example    Gemini·Claude·OpenAI 셋
#   .env.vllm.example     사내·온프렘 서버(vLLM 등)
#
# HTTPS·도메인으로 띄우는 법은 INSTALL_r-proxy.md.

# 이 템플릿이 쓰는 모델 구성: Ollama
LITELLM_CONFIG_FILE=./config/litellm_config_ollama.yaml
# 도커를 돌리는 이 PC에서 Ollama가 돈다면 그대로 둔다.
# host.docker.internal은 compose가 extra_hosts로 매핑해 세 OS에서 모두 동작한다.
OLLAMA_API_BASE=http://host.docker.internal:11434/v1
POSTGRES_USER=appuser
POSTGRES_PASSWORD=9hSoDrL8HxfBCUr1iNO96T6igjAxfK2U2Q2U7Kwd
POSTGRES_DB=appdb

# 채팅에 로그인할 계정. 관리자(admin)는 Keycloak 관리 화면용이라 설치에는 필요 없다.
APP_USER=appuser
APP_USER_PASSWORD=appuser
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=app-realm
KEYCLOAK_CLIENT_ID=ogjg-client
KEYCLOAK_CLIENT_SECRET=3v4yUxdNgF8gdsbnNFtlKeMstKfzcf6g6odhRLEj
KEYCLOAK_BFF_CLIENT_ID=ogjg-bff
KEYCLOAK_BFF_CLIENT_SECRET=Rwwg2G4duSXCzatsthpgxZOzVKU8q5VA0SlHjTN3
KEYCLOAK_PROXY_HEADERS=xforwarded

LITELLM_MASTER_KEY=sk-wGj3LppVio9YfzC80ruK8ggMVCpnn47CjDB8Sz7a
LITELLM_SALT_KEY=eQ8GnrEw5PmaCcF17mYV2nMQxM1fvGyOPbwD17aq

# 권한 기능(Casbin)을 켜는 법은 INSTALL.md의 「권한 기능 켜기」에 있다. 그대로 두면 꺼진 상태로 돈다.
SPRING_PROFILE=prod
BFF_IMAGE=ogjg-chat/backend-api:local
FRONTEND_IMAGE=ogjg-chat/frontend-nextjs:local
ETL_IMAGE=ogjg-chat/etl:local
NEXTAUTH_SECRET=JLv9GSicYiXjqSQ2fErPPRbv4kZ7Fff42eEQsXOe

# 브라우저가 접근하는 주소. 도커를 돌리는 그 PC에서 접속하는 전제다.
# 폰 등 다른 기기에서도 열려면 네 줄을 모두 이 PC의 IP로 바꾼다(INSTALL.md 1단계).
NEXTAUTH_URL=http://localhost:3010
PUBLIC_FRONTEND_URL=http://localhost:3010
PUBLIC_BFF_URL=http://localhost:8090
PUBLIC_KEYCLOAK_URL=http://localhost:8081

DOCUMENT_WORKER_INTERNAL_API_KEY=local-test-key
DOCUMENT_WORKER_SEAWEED_ROOT_PREFIX=documents
DOCUMENT_WORKER_MAX_REQUEST_BYTES=1048576
DOCUMENT_WORKER_MAX_OUTPUT_BYTES=26214400
DOCUMENT_WORKER_MAX_OPERATIONS=500
DOCUMENT_WORKER_RENDER_TIMEOUT_SECONDS=30
DOCUMENT_WORKER_LOG_LEVEL=INFO

# --- 방 문서 검색 준비(ETL, #340) — 선택 ---
# Elasticsearch와 ETL 워커를 켜려면 COMPOSE_PROFILES에 elasticsearch를 넣는다(예: COMPOSE_PROFILES=elasticsearch).
# EMBEDDING_URL은 OpenAI 호환 /v1/embeddings를 제공하는 주소다(사내 임베딩 서버). 비우면 ETL이 문서를 처리하지 않는다.
# 모델은 1024차원 벡터를 내야 한다(bge-m3). 다른 차원의 모델로 바꾸려면 검색 인덱스 매핑도 함께 바꿔야 한다.
EMBEDDING_URL=
EMBEDDING_MODEL=bge-m3
# 방 문서 검색(BFF)은 같은 EMBEDDING_URL로 질문을 임베딩한다. 후속 질문을 검색 문장으로 다시 쓰는 모델(비우면 그 대화의 모델),
# 검색 확인 API(POST /api/threads/{id}/documents/search) 켜기 여부.
RAG_REWRITE_MODEL=
RAG_SEARCH_API_ENABLED=true
# 문서 자동 태깅(#362). 문서마다 카테고리·키워드·요약을 뽑는다. OpenAI 호환 /v1/chat/completions를 제공하는 사내 LLM 서버 주소와
# 모델 이름을 넣는다(주소에 /v1은 붙이지 않는다). 문서 본문이 그대로 전달되므로 외부 공급자 주소를 넣지 않는다. 비우면 태깅만 꺼지고 문서 처리는 그대로다.
TAGGING_URL=
TAGGING_MODEL=
# 카테고리 목록(쉼표로 잇는다, 예: 인사·총무,보안·IT,기타). 비우면 기본 7개 목록이다. 바꾸면 태그만 다시 뽑는다.
TAGGING_CATEGORIES=
# 검색에 태그 채널을 더할지(평가로 확인한 뒤 켠다).
RAG_TAG_CHANNEL_ENABLED=false

# --- AI 턴의 웹 검색·웹 읽기 도구 ---
# 기본 켜짐. 웹 읽기는 사용자 발화와 그 턴의 검색 결과에 나온 주소만 읽고, 사내·내부 주소는 읽지 않는다.
# WEB_SEARCH_PROVIDER: duckduckgo(기본, 키 없음 — 비공식 HTML이라 요청이 몰리면 차단될 수 있다) 또는 searxng.
# searxng를 쓰려면 COMPOSE_PROFILES에 searxng를 더하고(예: COMPOSE_PROFILES=elasticsearch,searxng) SEARXNG_SECRET에
# 임의 문자열을 넣는다(예: openssl rand -hex 32). 비우면 searxng 컨테이너가 기동하지 않는다.
WEB_TOOLS_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
SEARXNG_SECRET=
